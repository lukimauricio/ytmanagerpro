<nav class="navbar">
  <div class="navbar-container">
    <div class="navbar-logo">
      <a href="/">YT MANAGER</a>
    </div>

    <ul class="navbar-links">
      <li><a href="/">Inicio</a></li>
      <li><a href="/services">Servicios</a></li>
      <li><a href="/faq">Preguntas</a></li>
      <li><a href="/terms">Términos</a></li>
      <li><a href="/contact">Contacto</a></li>
    </ul>

    <div class="nav-controls">
      <select id="currencySelect" onchange="setCurrency(this.value)">
        <option value="PEN">S/ Soles</option>
        <option value="USD">$ Dólares</option>
      </select>
    </div>
  </div>
</nav>

<style>
  .navbar {
    background-color: #400060;
    padding: 10px 20px;
    color: white;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .navbar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .navbar-logo a {
    color: white;
    font-size: 22px;
    font-weight: bold;
    text-decoration: none;
  }
  .navbar-links {
    list-style: none;
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
  }
  .navbar-links a {
    color: white;
    text-decoration: none;
  }
  .nav-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav-controls select {
    background: white;
    color: #333;
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 14px;
    cursor: pointer;
  }
</style>

<script>
  let CONFIG = null;

  // Cargar configuración
  async function loadConfig() {
    try {
      const res = await fetch("/config.json");
      CONFIG = await res.json();
      console.log("✅ Configuración cargada:", CONFIG);
    } catch (err) {
      console.error("❌ Error al cargar config.json:", err);
      CONFIG = { exchangeRate: 1, defaultCurrency: "PEN", whatsappNumber: "51999999999" };
    }
  }

  document.addEventListener("DOMContentLoaded", async () => {
    await loadConfig();

    const currSel = document.getElementById("currencySelect");
    currSel.value = localStorage.getItem("currency") || CONFIG.defaultCurrency || "PEN";

    updateInterface();
  });

  function setCurrency(curr) {
  localStorage.setItem("currency", curr);
  updateInterface();
  // 🔥 Notifica a todas las vistas abiertas que la moneda cambió
  window.dispatchEvent(new Event("currencyChanged"));
}


  function updateInterface() {
    const curr = localStorage.getItem("currency") || CONFIG.defaultCurrency || "PEN";
    const rate = Number(CONFIG.exchangeRate || 1);

    // 🔹 Actualizar precios
    document.querySelectorAll(".price-per-1000").forEach(el => {
      const pen = parseFloat(el.dataset.pricePen);
      if (isNaN(pen)) return;
      el.innerText = curr === "USD" ? `$${(pen / rate).toFixed(2)}` : `S/. ${pen.toFixed(2)}`;
    });

    // 🔹 Actualizar totales
    document.querySelectorAll(".qty-input").forEach(input => {
      const row = input.closest("tr");
      const totalEl = row.querySelector(".price-total");
      const pen = parseFloat(row.querySelector(".price-per-1000").dataset.pricePen);
      const qty = parseFloat(input.value) || 0;
      const total = (qty / 1000) * (curr === "USD" ? pen / rate : pen);
      totalEl.innerText =
        curr === "USD"
          ? `Total: $${total.toFixed(2)}`
          : `Total: S/. ${total.toFixed(2)}`;
    });
  }

  // Recalcular total al modificar cantidad
  document.addEventListener("input", e => {
    if (e.target.classList.contains("qty-input")) updateInterface();
  });
</script>

