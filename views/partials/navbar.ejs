<nav class="navbar">
  <div class="navbar-container">
    <div class="navbar-logo">
      <a href="/">YT MANAGER</a>
    </div>

    <ul class="navbar-links">
      <li><a href="/">Inicio</a></li>
      <li><a href="/services">Servicios</a></li>
      <li><a href="/faq">Preguntas</a></li>
      <li><a href="/terms">Términos</a></li>
      <li><a href="/contact">Contacto</a></li>
    </ul>

    <div class="nav-controls">
      <select id="currencySelect" onchange="setCurrency(this.value)">
        <option value="PEN">S/ Soles</option>
        <option value="USD">$ Dólares</option>
      </select>
    </div>
  </div>
</nav>

<style>
  .navbar {
    background-color: #400060;
    padding: 10px 20px;
    color: white;
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .navbar-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }

  .navbar-logo a {
    color: white;
    font-size: 22px;
    font-weight: bold;
    text-decoration: none;
  }

  .navbar-links {
    list-style: none;
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
  }

  .navbar-links a {
    color: white;
    text-decoration: none;
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-controls select {
    background: white;
    color: #333;
    border: none;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 14px;
    cursor: pointer;
  }
</style>
<script>
  // Cargar configuración global si no está ya cargada
  if (typeof window.APP_CONFIG === 'undefined') {
    window.APP_CONFIG = { exchangeRate: 4, defaultCurrency: "PEN" };
    fetch("/config.json")
      .then(res => res.json())
      .then(cfg => window.APP_CONFIG = cfg)
      .catch(err => console.warn("Usando configuración por defecto", err));
  }

  // Cambiar moneda y actualizar precios inmediatamente
  function setCurrency(currency) {
    localStorage.setItem("currency", currency);

    // 🔥 Forzar evento en todos los navegadores (incluyendo móviles)
    const event = new Event("currencyChanged", { bubbles: true, cancelable: true });
    window.dispatchEvent(event);

    // 🔥 En móviles, algunos no propagan bien el evento -> actualización directa forzada
    if (typeof updateServicePrices === "function") {
      updateServicePrices();
    }
  }

  // Inicializar selector de moneda al cargar
  document.addEventListener("DOMContentLoaded", () => {
    const saved = localStorage.getItem("currency") || (window.APP_CONFIG?.defaultCurrency || "PEN");
    document.getElementById("currencySelect").value = saved;
  });
</script>
