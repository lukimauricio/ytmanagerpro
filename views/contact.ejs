<section style="
  max-width: 1100px;
  margin: -20px auto;
  display: flex;
  flex-wrap: wrap;
  gap: 40px;
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 4px 25px rgba(0,0,0,0.1);
  padding: 50px 60px;
  font-family: 'Poppins', sans-serif;
  color: #333;
">
  <!-- Columna izquierda -->
  <div style="flex: 1 1 45%; min-width: 280px;">
    <h2 style="font-size: 2rem; font-weight: 700; color: #3d005f; margin-bottom: 15px;">
      Estamos aquí para ayudarte 💬
    </h2>
    <p style="color: #555; font-size: 1rem; margin-bottom: 25px;">
      Nuestro equipo de soporte y ventas está disponible los 7 días de la semana.
      Escríbenos y te responderemos lo antes posible.
    </p>

    <div style="
      background: #f8f6ff;
      border-left: 4px solid #3d00a1;
      border-radius: 8px;
      padding: 15px 18px;
      margin-bottom: 25px;
    ">
      <h4 style="color:#3d00a1; margin-bottom:8px;">❓ Preguntas frecuentes</h4>
      <p style="font-size:0.95rem; color:#444; margin:0;">
        Revisa nuestra <a href="/faq" style="color:#3d00a1; text-decoration:none; font-weight:600;">página de preguntas frecuentes</a>  
        para encontrar soluciones rápidas antes de contactar con soporte.
      </p>
    </div>

    <div style="margin-bottom:20px;">
      <p style="margin:0; font-weight:600;">📧 Ventas:</p>
      <a href="mailto:ventas@ytmanagerpro.com" style="color:#3d00a1; text-decoration:none;">ventas@ytmanagerpro.com</a>
    </div>

    <div style="margin-bottom:20px;">
      <p style="margin:0; font-weight:600;">🛠 Soporte técnico:</p>
      <a href="mailto:soporte@ytmanagerpro.com" style="color:#3d00a1; text-decoration:none;">soporte@ytmanagerpro.com</a>
    </div>

    <div>
      <p style="margin:0; font-weight:600;">📱 WhatsApp:</p>
      <a href="https://wa.me/51987654321" target="_blank" style="color:#3d00a1; text-decoration:none;">+51 987 654 321</a>
    </div>
  </div>

  <!-- Columna derecha -->
  <div style="flex: 1 1 45%; min-width: 280px; background:#fafafa; border-radius:12px; padding: 30px 35px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
    <h3 style="font-size:1.6rem; font-weight:700; color:#3d005f; margin-bottom:20px;">Contáctenos</h3>

    <!-- Selector de tipo de contacto -->
    <div style="display:flex; gap:20px; margin-bottom:15px;">
      <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-weight:600; color:#3d005f;">
        <input type="radio" name="destino" value="ventas" checked> Ventas
      </label>
      <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-weight:600; color:#3d005f;">
        <input type="radio" name="destino" value="soporte"> Soporte
      </label>
    </div>

    <form id="contactForm" style="display:flex; flex-direction:column; gap:18px;">
      <div>
        <label for="nombre" style="display:block; font-weight:600; margin-bottom:6px;">Nombre:</label>
        <input id="nombre" name="nombre" type="text" placeholder="Tu nombre" required
          style="width:100%; padding:12px 15px; border:1.5px solid #ccc; border-radius:8px; font-size:1rem;">
      </div>

      <div>
        <label for="email" style="display:block; font-weight:600; margin-bottom:6px;">Correo electrónico:</label>
        <input id="email" name="email" type="email" placeholder="tu@correo.com" required
          style="width:100%; padding:12px 15px; border:1.5px solid #ccc; border-radius:8px; font-size:1rem;">
      </div>

      <div>
        <label for="mensaje" style="display:block; font-weight:600; margin-bottom:6px;">¿Cómo podemos ayudarte?</label>
        <textarea id="mensaje" name="mensaje" rows="4" placeholder="Escribe tu consulta..." required
          style="width:100%; padding:12px 15px; border:1.5px solid #ccc; border-radius:8px; font-size:1rem; resize:vertical;"></textarea>
      </div>

      <button type="submit" style="
        background-color: #3d00a1;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 14px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
      ">Enviar mensaje</button>
    </form>
  </div>
</section>

<script>
  document.getElementById("contactForm").addEventListener("submit", function(e) {
    e.preventDefault();

    // obtener valores
    const nombre = document.getElementById("nombre").value;
    const email = document.getElementById("email").value;
    const mensaje = document.getElementById("mensaje").value;
    const destino = document.querySelector('input[name="destino"]:checked').value;

    // seleccionar correo destino
    let correoDestino = destino === "ventas"
      ? "ventas@ytmanagerpro.com"
      : "soporte@ytmanagerpro.com";

    // abrir cliente de correo con los datos
    window.location.href = `mailto:${correoDestino}?subject=Consulta de ${nombre}&body=De: ${email}%0A%0A${mensaje}`;
  });
</script>
