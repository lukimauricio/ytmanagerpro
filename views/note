      <% if (cat === 'instagram') { %><i class="fab fa-instagram"></i> Instagram<% } %>			<!-- HTML: Icono y texto para Instagram -->
    </div>																							<!-- HTML: Fin del encabezado -->

    <!-- Tabla para escritorio -->
    <table class="service-table">																	<!-- HTML: Tabla de servicios -->
      <thead>																						<!-- HTML: Cabecera de la tabla -->
        <tr>																						<!-- HTML: Fila de encabezado -->
          <th>ID</th>																				<!-- HTML: Celda de encabezado ID -->
