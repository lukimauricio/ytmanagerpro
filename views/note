      </thead>																						<!-- HTML: Fin de la cabecera -->
      <tbody>																						<!-- HTML: Cuerpo de la tabla -->
        <% services[cat].forEach(service => { 														<!-- EJS: Itera sobre los servicios de la categoría actual -->
          const pricePen = Number(service.pricePerThousandPEN || 0);								<!-- EJS: Calcula el precio en PEN -->
        %>																							<!-- EJS: Fin de la lógica EJS -->
        <tr>																						<!-- HTML: Fila de datos -->
          <td data-label="ID"><%= service.id %></td>												<!-- HTML: Celda de ID -->
          <td data-label="Categoría"><%= service.category || '-' %></td>							<!-- HTML: Celda de Categoría -->
          <td data-label="Servicio"><%= service.service %></td>									<!-- HTML: Celda de Servicio -->
          <td data-label="Precio x 1000" class="price-per-1000" data-id="<%= service.id %>" data-price-pen="<%= pricePen %>">S/. <%= pricePen.toFixed(2) %></td>	<!-- HTML: Celda de Precio -->
          <td data-label="Mínimo"><%= service.min.toLocaleString('es-ES') %></td>					<!-- HTML: Celda de Mínimo -->
          <td data-label="Máximo"><%= service.max.toLocaleString('es-ES') %></td>					<!-- HTML: Celda de Máximo -->
          <td data-label="Descripción"><button class="desc-btn" data-id="<%= service.id %>">Ver descripción</button></td>	<!-- HTML: Celda con botón de descripción -->
          <td data-label="Acciones">																<!-- HTML: Celda de Acciones -->
            <button																					<!-- HTML: Botón de compra -->
              class="buy-btn"																		<!-- HTML: Clase del botón -->
              data-platform="<%= cat %>"															<!-- HTML: Atributo de datos plataforma -->
              data-id="<%= service.id %>"															<!-- HTML: Atributo de datos ID -->
              data-service="<%= encodeURIComponent(service.service) %>"							<!-- HTML: Atributo de datos servicio -->
              data-min="<%= service.min %>"															<!-- HTML: Atributo de datos mínimo -->
              data-max="<%= service.max %>"															<!-- HTML: Atributo de datos máximo -->
              data-price-pen="<%= pricePen %>"														<!-- HTML: Atributo de datos precio PEN -->
            >																						<!-- HTML: Fin de los atributos del botón -->
              Comprar																				<!-- HTML: Texto del botón -->
            </button>																				<!-- HTML: Fin del botón -->
          </td>																					<!-- HTML: Fin de la celda de acciones -->
        </tr>																						<!-- HTML: Fin de la fila de datos -->
        <% }) %>																					<!-- EJS: Fin de la iteración de servicios -->
      </tbody>																						<!-- HTML: Fin del cuerpo -->
    </table>																						<!-- HTML: Fin de la tabla -->

    <!-- Tarjetas para móviles -->
    <div class="mobile-service-cards" style="display: none;">										<!-- HTML: Contenedor de tarjetas móviles -->
      <% services[cat].forEach(service => { 														<!-- EJS: Itera sobre los servicios de la categoría actual -->
        const pricePen = Number(service.pricePerThousandPEN || 0);								<!-- EJS: Calcula el precio en PEN -->
      %>																							<!-- EJS: Fin de la lógica EJS -->
      <div class="service-card" data-id="<%= service.id %>">										<!-- HTML: Tarjeta de servicio -->
        <div class="service-card-row">																<!-- HTML: Fila dentro de la tarjeta -->
