          <th>Servicio</th>																		<!-- HTML: Celda de encabezado Servicio -->
          <th>Precio x 1000</th>																	<!-- HTML: Celda de encabezado Precio x 1000 -->
          <th>Mínimo</th>																			<!-- HTML: Celda de encabezado Mínimo -->
          <th>Máximo</th>																			<!-- HTML: Celda de encabezado Máximo -->
