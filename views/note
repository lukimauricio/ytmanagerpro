<!-- 🔹 Pasar los servicios al front -->
<script>																							<!-- JS: Bloque de script -->
  window.SERVICES = <%- JSON.stringify(services || {}) %>;											<!-- JS: Pasa el objeto services del backend al frontend -->
</script>																							<!-- JS: Fin del bloque de script -->

<!-- 🔹 Script para manejar los filtros -->
<script>																							<!-- JS: Bloque de script -->
  // Función para actualizar las categorías en el segundo filtro según la plataforma seleccionada		<!-- JS: Comentario -->
  function updateCategoryFilter(platform) {														<!-- JS: Define la función updateCategoryFilter -->
    const categorySelect = document.getElementById('categoryFilter');								<!-- JS: Obtiene el elemento select de categoría -->
    // Limpiar opciones existentes (excepto "Todas")												<!-- JS: Comentario -->
    while (categorySelect.options.length > 1) {													<!-- JS: Bucle para limpiar opciones -->
      categorySelect.remove(1);																	<!-- JS: Elimina la opción -->
    }																								<!-- JS: Fin del bucle -->

    if (platform === 'all') {																		<!-- JS: Condición si la plataforma es 'all' -->
      // Si se selecciona "Todas", no llenamos el filtro de categoría, solo mostramos "Todas"		<!-- JS: Comentario -->
      return;																					<!-- JS: Sale de la función -->
    }																								<!-- JS: Fin de la condición -->

    // Obtener todas las categorías únicas de la plataforma seleccionada							<!-- JS: Comentario -->
    const categories = new Set();																	<!-- JS: Crea un conjunto para categorías únicas -->
    const servicesForPlatform = window.SERVICES[platform] || [];									<!-- JS: Obtiene servicios para la plataforma -->
    servicesForPlatform.forEach(service => {														<!-- JS: Itera sobre los servicios -->
      if (service.category) {																		<!-- JS: Condición si el servicio tiene categoría -->
        categories.add(service.category);															<!-- JS: Añade la categoría al conjunto -->
      }																							<!-- JS: Fin de la condición -->
    });																							<!-- JS: Fin de la iteración -->

    // Añadir cada categoría como opción																<!-- JS: Comentario -->
    categories.forEach(category => {																<!-- JS: Itera sobre las categorías únicas -->
      const option = document.createElement('option');												<!-- JS: Crea un elemento option -->
      option.value = category;																		<!-- JS: Establece el valor -->
      option.textContent = category;																<!-- JS: Establece el texto -->
      categorySelect.appendChild(option);															<!-- JS: Añade la opción al select -->
    });																							<!-- JS: Fin de la iteración -->
  }																									<!-- JS: Fin de la función updateCategoryFilter -->

  // Función para aplicar los filtros																<!-- JS: Comentario -->
  function applyFilters() {																			<!-- JS: Define la función applyFilters -->
    const platformFilter = document.getElementById('platformFilter').value;							<!-- JS: Obtiene el valor del filtro de plataforma -->
    const categoryFilter = document.getElementById('categoryFilter').value;							<!-- JS: Obtiene el valor del filtro de categoría -->

    // Mostrar u ocultar secciones de plataforma													<!-- JS: Comentario -->
    Object.keys(window.SERVICES).forEach(platform => {												<!-- JS: Itera sobre las claves de servicios -->
      const section = document.getElementById(platform);											<!-- JS: Obtiene la sección de la plataforma -->
      if (platformFilter === 'all' || platform === platformFilter) {								<!-- JS: Condición para mostrar sección -->
        section.classList.remove('hidden');														<!-- JS: Remueve la clase 'hidden' -->
      } else {																					<!-- JS: Condición alternativa -->
        section.classList.add('hidden');															<!-- JS: Añade la clase 'hidden' -->
      }																							<!-- JS: Fin de la condición -->
    });																							<!-- JS: Fin de la iteración -->

    // Filtrar filas dentro de cada tabla visible													<!-- JS: Comentario -->
    Object.keys(window.SERVICES).forEach(platform => {												<!-- JS: Itera sobre las claves de servicios -->
      const section = document.getElementById(platform);											<!-- JS: Obtiene la sección de la plataforma -->
      if (!section.classList.contains('hidden')) {													<!-- JS: Condición si la sección no está oculta -->
        const tableRows = section.querySelectorAll('.service-table tbody tr');						<!-- JS: Selecciona filas de la tabla -->
        tableRows.forEach(row => {																<!-- JS: Itera sobre las filas -->
          const rowCategory = row.querySelector('td:nth-child(2)').textContent.trim(); // Categoría está en la 2da columna	<!-- JS: Obtiene la categoría de la fila -->
          if (categoryFilter === 'all' || rowCategory === categoryFilter) {							<!-- JS: Condición para mostrar fila -->
            row.style.display = 'table-row';														<!-- JS: Muestra la fila -->
          } else {																				<!-- JS: Condición alternativa -->
            row.style.display = 'none';															<!-- JS: Oculta la fila -->
          }																						<!-- JS: Fin de la condición -->
        });																						<!-- JS: Fin de la iteración -->

        // También filtrar tarjetas móviles															<!-- JS: Comentario -->
        const mobileCards = section.querySelectorAll('.mobile-service-cards .service-card');		<!-- JS: Selecciona tarjetas móviles -->
        mobileCards.forEach(card => {																<!-- JS: Itera sobre las tarjetas -->
          const cardCategory = card.querySelector('.service-card-row:nth-child(2) .service-value').textContent.trim(); // Categoría en la 2da fila	<!-- JS: Obtiene la categoría de la tarjeta -->
          if (categoryFilter === 'all' || cardCategory === categoryFilter) {						<!-- JS: Condición para mostrar tarjeta -->
            card.style.display = 'flex'; // o 'block', dependiendo de tu CSS							<!-- JS: Muestra la tarjeta -->
          } else {																				<!-- JS: Condición alternativa -->
            card.style.display = 'none';															<!-- JS: Oculta la tarjeta -->
          }																						<!-- JS: Fin de la condición -->
        });																						<!-- JS: Fin de la iteración -->
      }																							<!-- JS: Fin de la condición -->
    });																							<!-- JS: Fin de la iteración -->
  }																									<!-- JS: Fin de la función applyFilters -->

  // Eventos para los selectores																		<!-- JS: Comentario -->
  document.getElementById('platformFilter').addEventListener('change', function() {					<!-- JS: Añade evento change al select de plataforma -->
    const selectedPlatform = this.value;															<!-- JS: Obtiene la plataforma seleccionada -->
    updateCategoryFilter(selectedPlatform);														<!-- JS: Actualiza el filtro de categoría -->
    applyFilters();																				<!-- JS: Aplica los filtros -->
  });																								<!-- JS: Fin del evento -->

  document.getElementById('categoryFilter').addEventListener('change', function() {					<!-- JS: Añade evento change al select de categoría -->
    applyFilters();																				<!-- JS: Aplica los filtros -->
  });																								<!-- JS: Fin del evento -->

  // Inicializar el filtro de categoría con la primera plataforma seleccionada (si no es "all")		<!-- JS: Comentario -->
  document.addEventListener('DOMContentLoaded', function() {										<!-- JS: Añade evento DOMContentLoaded -->
    const initialPlatform = document.getElementById('platformFilter').value;						<!-- JS: Obtiene la plataforma inicial -->
    if (initialPlatform !== 'all') {																<!-- JS: Condición si la plataforma no es 'all' -->
      updateCategoryFilter(initialPlatform);														<!-- JS: Actualiza el filtro de categoría -->
    }																								<!-- JS: Fin de la condición -->
  });																								<!-- JS: Fin del evento -->
</script>																							<!-- JS: Fin del bloque de script -->

<!-- 🔹 Render HTML de categorías -->
<% Object.keys(services).forEach(cat => { %>														<!-- EJS: Itera sobre las claves del objeto services -->
  <div class="category-section" id="<%= cat %>">													<!-- HTML: Contenedor para cada categoría/plataforma -->
    <div class="category-header">																	<!-- HTML: Encabezado de la sección -->
