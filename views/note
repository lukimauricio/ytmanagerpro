            data-platform="<%= cat %>"																<!-- HTML: Atributo de datos plataforma -->
            data-id="<%= service.id %>"																<!-- HTML: Atributo de datos ID -->
            data-service="<%= encodeURIComponent(service.service) %>"								<!-- HTML: Atributo de datos servicio -->
            data-min="<%= service.min %>"															<!-- HTML: Atributo de datos mínimo -->
            data-max="<%= service.max %>"															<!-- HTML: Atributo de datos máximo -->
            data-price-pen="<%= pricePen %>"														<!-- HTML: Atributo de datos precio PEN -->
          >																						<!-- HTML: Fin de los atributos del botón -->
            Comprar																				<!-- HTML: Texto del botón -->
          </button>																				<!-- HTML: Fin del botón -->
        </div>																						<!-- HTML: Fin del contenedor de acciones -->
      </div>																						<!-- HTML: Fin de la tarjeta -->
      <% }) %>																					<!-- EJS: Fin de la iteración de servicios -->
    </div>																							<!-- HTML: Fin del contenedor de tarjetas móviles -->
  </div>																							<!-- HTML: Fin del contenedor de categoría -->
<% }) %>																							<!-- EJS: Fin de la iteración de categorías -->

<!-- 🔹 Modal de descripción -->
<div id="descModal" class="desc-modal">															<!-- HTML: Contenedor del modal de descripción -->
  <div class="desc-box">																			<!-- HTML: Cuadro de contenido del modal -->
    <button class="desc-close" onclick="closeDescModal()">&times;</button>							<!-- HTML: Botón de cierre del modal -->
    <h3>Descripción del servicio</h3>																<!-- HTML: Título del modal -->
    <div id="descContent"></div>																	<!-- HTML: Contenedor para el contenido dinámico -->
  </div>																							<!-- HTML: Fin del cuadro de contenido -->
</div>																								<!-- HTML: Fin del contenedor del modal -->

<!-- 🔹 Modal de compra (nueva orden) -->
<div id="orderModal" class="order-modal">															<!-- HTML: Contenedor del modal de compra -->
  <div class="order-modal-content">																<!-- HTML: Contenido del modal de compra -->
    <span class="close-btn" onclick="closeOrderModal()">&times;</span>								<!-- HTML: Botón de cierre del modal -->
    <h3>🧾 Nueva orden</h3>																		<!-- HTML: Título del modal -->
    
    <p><b>Plataforma:</b> <span id="order-platform"></span></p>									<!-- HTML: Párrafo con plataforma -->
    <p><b>ID:</b> <span id="order-id"></span></p>													<!-- HTML: Párrafo con ID -->
    <p><b>Servicio:</b> <span id="order-service"></span></p>										<!-- HTML: Párrafo con servicio -->
    
    <label for="order-quantity-input">Cantidad:</label>											<!-- HTML: Etiqueta para input de cantidad -->
    <input type="number" id="order-quantity-input" min="0" step="1" />								<!-- HTML: Input para cantidad -->
    <div class="error-msg" id="order-error"></div>												<!-- HTML: Contenedor para mensaje de error -->
    
    <div id="order-total">Total a pagar: S/. 0.00</div>											<!-- HTML: Div para mostrar total -->
    
    <label for="order-link">Enlace del contenido:</label>											<!-- HTML: Etiqueta para input de enlace -->
    <input type="text" id="order-link" placeholder="    https://www.youtube.com/...    " />		<!-- HTML: Input para enlace (con espacios en el placeholder) -->
    
    <div class="modal-buttons">																		<!-- HTML: Contenedor de botones del modal -->
      <button class="cancel-btn" onclick="closeOrderModal()">Cancelar</button>						<!-- HTML: Botón de cancelar -->
      <button class="confirm-btn" id="confirmOrder" disabled>Confirmar pedido</button>				<!-- HTML: Botón de confirmar (deshabilitado inicialmente) -->
    </div>																							<!-- HTML: Fin del contenedor de botones -->
  </div>																							<!-- HTML: Fin del contenido del modal -->
</div>																								<!-- HTML: Fin del contenedor del modal -->

<script>																							<!-- JS: Bloque de script -->
  // === Variables globales ===																		<!-- JS: Comentario -->
  let currentOrder = null;																			<!-- JS: Variable para almacenar la orden actual -->

  // === Funciones de cierre de modales ===															<!-- JS: Comentario -->
  function closeDescModal() {																		<!-- JS: Función para cerrar modal de descripción -->
    document.getElementById("descModal").classList.remove("active");								<!-- JS: Remueve la clase 'active' -->
  }																									<!-- JS: Fin de la función -->

  function closeOrderModal() {																		<!-- JS: Función para cerrar modal de compra -->
    document.getElementById("orderModal").classList.remove("active");								<!-- JS: Remueve la clase 'active' -->
  }																									<!-- JS: Fin de la función -->

  // === Modal de descripción ===																	<!-- JS: Comentario -->
  document.querySelectorAll(".desc-btn").forEach(btn => {											<!-- JS: Selecciona todos los botones de descripción y añade evento -->
    btn.addEventListener("click", e => {															<!-- JS: Añade evento click -->
      const id = e.target.dataset.id;																<!-- JS: Obtiene el ID del servicio -->
      const service = Object.values(window.SERVICES).flat().find(s => s.id == id);					<!-- JS: Busca el servicio correspondiente -->
      if (!service) return;																		<!-- JS: Sale si no encuentra el servicio -->

      const desc = service.description || "Sin descripción disponible.";							<!-- JS: Obtiene la descripción -->
      const notes = service.notes_es || service.notes || [];										<!-- JS: Obtiene las notas -->
      const quality = service.quality || "No especificado";											<!-- JS: Obtiene la calidad -->
      const start = service.start_time || "-";														<!-- JS: Obtiene el tiempo de inicio -->
      const speed = service.speed || "-";															<!-- JS: Obtiene la velocidad -->
      const refill = service.refill || "No aplica";												<!-- JS: Obtiene la recarga -->
      const drop = service.drop || "No";															<!-- JS: Obtiene el drop -->

      let html = `																					<!-- JS: Inicia la construcción del HTML -->
        <h3>${service.service}</h3>																<!-- JS: Título del servicio -->
        <p>${desc}</p>																				<!-- JS: Descripción -->
        <hr>																					<!-- JS: Línea divisoria -->
        <ul>																					<!-- JS: Lista de detalles -->
          <li>💎 <strong>Calidad:</strong> ${quality}</li>											<!-- JS: Calidad -->
          <li>⏱️ <strong>Inicio:</strong> ${start}</li>											<!-- JS: Inicio -->
          <li>⚡ <strong>Velocidad:</strong> ${speed}</li>											<!-- JS: Velocidad -->
          <li>🔁 <strong>Recarga:</strong> ${refill}</li>											<!-- JS: Recarga -->
          <li>📉 <strong>Drop:</strong> ${drop}</li>												<!-- JS: Drop -->
        </ul>																					<!-- JS: Fin de la lista -->
      `;																							<!-- JS: Fin de la primera parte del HTML -->

      if (notes.length > 0) {																		<!-- JS: Condición si hay notas -->
        html += `																					<!-- JS: Añade HTML para notas -->
          <hr>																					<!-- JS: Línea divisoria -->
          <div class="note">																		<!-- JS: Contenedor de nota -->
            <strong>⚠️ Notas:</strong>																<!-- JS: Título de notas -->
            <ul style="padding-left: 18px; margin-top: 6px;">										<!-- JS: Lista de notas -->
              ${notes.map(n => `<li>${n}</li>`).join("")}											<!-- JS: Mapea y une las notas -->
            </ul>																					<!-- JS: Fin de la lista de notas -->
          </div>																					<!-- JS: Fin del contenedor de nota -->
        `;																							<!-- JS: Fin de la parte de notas -->
      }																								<!-- JS: Fin de la condición -->

      document.getElementById("descContent").innerHTML = html;										<!-- JS: Inserta el HTML generado -->
      document.getElementById("descModal").classList.add("active");								<!-- JS: Añade la clase 'active' al modal -->
    });																							<!-- JS: Fin del evento click -->
  });																								<!-- JS: Fin del bucle forEach -->

  // === Modal de compra ===																		<!-- JS: Comentario -->
  document.querySelectorAll(".buy-btn").forEach(btn => {											<!-- JS: Selecciona todos los botones de compra y añade evento -->
    btn.addEventListener("click", () => {															<!-- JS: Añade evento click -->
      const platform = btn.dataset.platform;														<!-- JS: Obtiene la plataforma -->
      const id = btn.dataset.id;																	<!-- JS: Obtiene el ID -->
      const service = decodeURIComponent(btn.dataset.service);										<!-- JS: Obtiene y decodifica el nombre del servicio -->
      const min = parseInt(btn.dataset.min);														<!-- JS: Obtiene el mínimo -->
      const max = parseInt(btn.dataset.max);														<!-- JS: Obtiene el máximo -->
      const pricePen = parseFloat(btn.dataset.pricePen);											<!-- JS: Obtiene el precio en PEN -->

      currentOrder = { platform, id, service, min, max, pricePen };								<!-- JS: Almacena la orden actual -->

      // Rellenar modal																			<!-- JS: Comentario -->
      document.getElementById("order-platform").textContent = platform.charAt(0).toUpperCase() + platform.slice(1);	<!-- JS: Rellena la plataforma -->
      document.getElementById("order-id").textContent = id;											<!-- JS: Rellena el ID -->
      document.getElementById("order-service").textContent = service;								<!-- JS: Rellena el servicio -->
      document.getElementById("order-quantity-input").value = min;									<!-- JS: Rellena la cantidad con el mínimo -->
      document.getElementById("order-link").value = "";											<!-- JS: Limpia el enlace -->
      document.getElementById("order-error").textContent = "";										<!-- JS: Limpia el mensaje de error -->
      document.getElementById("order-error").style.display = "none";								<!-- JS: Oculta el mensaje de error -->
      
      // Forzar actualización del total															<!-- JS: Comentario -->
      updateOrderTotal(min);																		<!-- JS: Actualiza el total -->
      validateQuantity(min);																		<!-- JS: Valida la cantidad -->

      // Mostrar modal																				<!-- JS: Comentario -->
      document.getElementById("orderModal").classList.add("active");								<!-- JS: Muestra el modal -->
    });																							<!-- JS: Fin del evento click -->
  });																								<!-- JS: Fin del bucle forEach -->

  // Actualizar total en tiempo real																<!-- JS: Comentario -->
  const quantityInput = document.getElementById("order-quantity-input");							<!-- JS: Obtiene el input de cantidad -->
  if (quantityInput) {																				<!-- JS: Condición si el input existe -->
    quantityInput.addEventListener("input", function(e) {											<!-- JS: Añade evento input -->
      const qty = parseInt(this.value) || 0;														<!-- JS: Obtiene la cantidad -->
      updateOrderTotal(qty);																		<!-- JS: Actualiza el total -->
      validateQuantity(qty);																		<!-- JS: Valida la cantidad -->
    });																							<!-- JS: Fin del evento input -->
  }																									<!-- JS: Fin de la condición -->

  function updateOrderTotal(qty) {																	<!-- JS: Define la función updateOrderTotal -->
    if (!currentOrder) return;																		<!-- JS: Sale si no hay orden -->

    const rate = Number(window.APP_CONFIG?.exchangeRate || 4);										<!-- JS: Obtiene el tipo de cambio -->
    const curr = localStorage.getItem("currency") || window.APP_CONFIG?.defaultCurrency || "PEN";	<!-- JS: Obtiene la moneda -->
    const total = (qty / 1000) * currentOrder.pricePen;											<!-- JS: Calcula el total en PEN -->
    const totalInCurr = curr === "USD" ? total / rate : total;										<!-- JS: Convierte a la moneda seleccionada -->
    const symbol = curr === "USD" ? "$" : "S/.";													<!-- JS: Obtiene el símbolo de moneda -->

    const totalElement = document.getElementById("order-total");									<!-- JS: Obtiene el elemento del total -->
    if (totalElement) {																			<!-- JS: Condición si el elemento existe -->
      totalElement.textContent = `${symbol} ${totalInCurr.toFixed(2)}`;							<!-- JS: Actualiza el texto del total -->
    }																								<!-- JS: Fin de la condición -->
  }																									<!-- JS: Fin de la función -->

  function validateQuantity(qty) {																	<!-- JS: Define la función validateQuantity -->
    const errorEl = document.getElementById("order-error");										<!-- JS: Obtiene el elemento de error -->
    const confirmBtn = document.getElementById("confirmOrder");										<!-- JS: Obtiene el botón de confirmar -->

    if (!currentOrder) return;																		<!-- JS: Sale si no hay orden -->

    if (qty < currentOrder.min) {																	<!-- JS: Condición si la cantidad es menor al mínimo -->
      errorEl.textContent = `⚠️ Mínimo: ${currentOrder.min}`;										<!-- JS: Muestra mensaje de error -->
      errorEl.style.display = "block";																<!-- JS: Muestra el mensaje -->
      confirmBtn.disabled = true;																	<!-- JS: Deshabilita el botón -->
    } else if (qty > currentOrder.max) {															<!-- JS: Condición si la cantidad es mayor al máximo -->
      errorEl.textContent = `⚠️ Máximo: ${currentOrder.max}`;										<!-- JS: Muestra mensaje de error -->
      errorEl.style.display = "block";																<!-- JS: Muestra el mensaje -->
      confirmBtn.disabled = true;																	<!-- JS: Deshabilita el botón -->
    } else {																					<!-- JS: Condición alternativa (cantidad válida) -->
      errorEl.style.display = "none";																<!-- JS: Oculta el mensaje -->
      confirmBtn.disabled = false;																	<!-- JS: Habilita el botón -->
    }																								<!-- JS: Fin de la condición -->
  }																									<!-- JS: Fin de la función -->

    // Confirmar orden																				<!-- JS: Comentario -->
  document.getElementById("confirmOrder")?.addEventListener("click", () => {						<!-- JS: Añade evento click al botón de confirmar -->
    const qtyInput = document.getElementById("order-quantity-input");								<!-- JS: Obtiene el input de cantidad -->
    const linkInput = document.getElementById("order-link");										<!-- JS: Obtiene el input de enlace -->
    const qty = parseInt(qtyInput.value) || 0;														<!-- JS: Obtiene la cantidad -->
    const link = linkInput.value.trim();															<!-- JS: Obtiene y limpia el enlace -->
    const errorEl = document.getElementById("order-error");										<!-- JS: Obtiene el elemento de error -->

    if (!currentOrder) {																			<!-- JS: Condición si no hay orden -->
      alert("Error interno. Recarga la página.");													<!-- JS: Muestra alerta -->
      return;																					<!-- JS: Sale de la función -->
    }																								<!-- JS: Fin de la condición -->

    if (qty < currentOrder.min) {																	<!-- JS: Condición si la cantidad es menor al mínimo -->
      errorEl.textContent = `Mínimo: ${currentOrder.min}`;											<!-- JS: Muestra mensaje de error -->
      errorEl.style.display = "block";																<!-- JS: Muestra el mensaje -->
      return;																					<!-- JS: Sale de la función -->
    }																								<!-- JS: Fin de la condición -->
    if (qty > currentOrder.max) {																	<!-- JS: Condición si la cantidad es mayor al máximo -->
      errorEl.textContent = `Máximo: ${currentOrder.max}`;											<!-- JS: Muestra mensaje de error -->
      errorEl.style.display = "block";																<!-- JS: Muestra el mensaje -->
      return;																					<!-- JS: Sale de la función -->
    }																								<!-- JS: Fin de la condición -->
    if (!link) {																					<!-- JS: Condición si no hay enlace -->
      errorEl.textContent = "Ingresa el enlace del contenido.";									<!-- JS: Muestra mensaje de error -->
      errorEl.style.display = "block";																<!-- JS: Muestra el mensaje -->
      return;																					<!-- JS: Sale de la función -->
    }																								<!-- JS: Fin de la condición -->

    const rate = Number(window.APP_CONFIG?.exchangeRate || 4);										<!-- JS: Obtiene el tipo de cambio -->
    const curr = localStorage.getItem("currency") || window.APP_CONFIG?.defaultCurrency || "PEN";	<!-- JS: Obtiene la moneda -->
    const total = (qty / 1000) * currentOrder.pricePen;											<!-- JS: Calcula el total en PEN -->
    const totalInCurr = curr === "USD" ? total / rate : total;										<!-- JS: Convierte a la moneda seleccionada -->
    const symbol = curr === "USD" ? "$" : "S/.";													<!-- JS: Obtiene el símbolo de moneda -->

    const mensaje = `🧾 *Nueva orden YT Manager*%0A` +												<!-- JS: Construye el mensaje para WhatsApp -->
                    `🔹 *Plataforma:* ${currentOrder.platform.charAt(0).toUpperCase() + currentOrder.platform.slice(1)}%0A` +
                    `🔹 *ID:* ${currentOrder.id}%0A` +
                    `🔹 *Servicio:* ${currentOrder.service}%0A` +
                    `🔹 *Cantidad:* ${qty}%0A` +
                    `🔹 *Enlace:* ${encodeURIComponent(link)}%0A%0A` +
                    `💰 *Total:* ${symbol} ${totalInCurr.toFixed(2)} (${curr})`;

    // --- CORRECCIÓN: Comentario sobre la ubicación del número ---								<!-- JS: Comentario -->
    // El número de WhatsApp se espera que esté disponible en window.APP_CONFIG?.whatsapp			<!-- JS: Comentario -->
    // Esta variable debería ser cargada previamente desde config.json ubicado en images/public		<!-- JS: Comentario -->
    const telefono = (window.APP_CONFIG?.whatsapp || "").replace(/\D/g, "");						<!-- JS: Obtiene y limpia el número de teléfono -->
    if (!telefono) {																				<!-- JS: Condición si no hay número -->
      alert("⚠️ WhatsApp no configurado.");														<!-- JS: Muestra alerta -->
      return;																					<!-- JS: Sale de la función -->
    }																								<!-- JS: Fin de la condición -->

    // --- CORRECCIÓN: Eliminación de espacios en la URL ---										<!-- JS: Comentario -->
    const url = `https://wa.me/  ${telefono}?text=${mensaje}`;										<!-- JS: Construye la URL de WhatsApp (CORREGIR ESTA LÍNEA) -->
    window.open(url, "_blank");																		<!-- JS: Abre la URL en una nueva pestaña -->

    closeOrderModal();																				<!-- JS: Cierra el modal -->
  });																								<!-- JS: Fin del evento click -->

  // Cerrar modal de orden al hacer clic fuera														<!-- JS: Comentario -->
  document.getElementById("orderModal")?.addEventListener("click", e => {							<!-- JS: Añade evento click al contenedor del modal -->
    if (e.target.id === "orderModal") {															<!-- JS: Condición si se hizo clic fuera del contenido -->
      closeOrderModal();																			<!-- JS: Cierra el modal -->
    }																								<!-- JS: Fin de la condición -->
  });																								<!-- JS: Fin del evento -->

  // Cerrar modal de descripción al hacer clic fuera												<!-- JS: Comentario -->
  document.getElementById("descModal")?.addEventListener("click", e => {							<!-- JS: Añade evento click al contenedor del modal -->
    if (e.target.id === "descModal") {															<!-- JS: Condición si se hizo clic fuera del contenido -->
      closeDescModal();																			<!-- JS: Cierra el modal -->
    }																								<!-- JS: Fin de la condición -->
  });																								<!-- JS: Fin del evento -->
</script>																							<!-- JS: Fin del bloque de script -->